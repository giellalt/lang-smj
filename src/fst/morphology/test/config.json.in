{
    "analyser": "@abs_builddir@/../../analyser-gt-norm.hfstol",
    "generator": "@abs_builddir@/../../generator-gt-norm.hfstol",
    "lexcroot": "@abs_srcdir@/../root.lexc",
    "nouns": {
        "lexcfile": "@abs_srcdir@/../stems/nouns.lexc",
        "lemmatags": ["+N+Sg+Nom", "+N+Pl+Nom"],
        "exclusions": ["(ShCmp|RCmpnd|ÅLLAGASJ|CmpN/Only|Err/Der|Err/Lex|Use/MT|Use/-Spell|CmpNP/Suff|CmpNP/Pref|Err/Cmp)"]
    },
    "adjectives": {
        "lexcfile": "@abs_srcdir@/../stems/adjectives.lexc",
        "lemmatags": ["+A+Sg+Nom"]
    },
    "propernouns": {
        "lexcfile": "@abs_srcdir@/../stems/smj-propernouns.lexc",
        "lemmatags": ["+N+Prop+Sg+Nom", "+N+Prop+Pl+Nom", "+N+Prop+Attr"],
        "exclusions": ["(Use/-Spell)"]
    },
    "verbs": {
        "lexcfile": "@abs_srcdir@/../stems/verbs.lexc",
        "lemmatags": ["+V+Inf"],
        "exclusions": ["(\\+Neg|STRAYFORMS|\\+Use/MT|Err/Lex|ShCmp|RCmpnd|CmpN/Only|Err/Cmp)"]
    },
    "otherlexcs": [
        "@abs_srcdir@/../stems/adpositions.lexc",
        "@abs_srcdir@/../stems/adverbs.lexc",
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/conjunctions.lexc",
        "@abs_srcdir@/../stems/interjections.lexc",
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/pronouns.lexc",
        "@abs_srcdir@/../affixes/abbreviations.lexc",
        "@abs_srcdir@/../affixes/adjectives.lexc",
        "@abs_srcdir@/../affixes/nouns.lexc",
        "@abs_srcdir@/../affixes/numerals.lexc",
        "@abs_srcdir@/../affixes/possessives.lexc",
        "@abs_srcdir@/../affixes/propernouns.lexc",
        "@abs_srcdir@/../affixes/symbols.lexc",
        "@abs_srcdir@/../affixes/verbs.lexc",
        "@abs_builddir@/../generated_files/smi-smj-abbreviations.lexc",
        "@abs_builddir@/../generated_files/smi-smj-acronyms.lexc",
        "@abs_builddir@/../generated_files/smi-smj-arabic_roman_digits.lexc",
        "@abs_builddir@/../generated_files/smi-smj-digits.lexc",
        "@abs_builddir@/../generated_files/mul-smj-punctuation.lexc",
        "@abs_builddir@/../generated_files/mul-smj-symbols.lexc"
    ]
}
