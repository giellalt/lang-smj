#!/bin/bash

# Guards the never-suggest barrier.
#
# weights/tags.reweight prices two kinds of tag in the thousands, and
# config.json's max-weight decides which of them a user ever sees:
#
#   hard block   +Use/SpellNoSugg, +Use/Derrog, +Cmp/Hyph and +Cmp/SplitR,
#                all at +10000. At or above max-weight, so a form carrying
#                one is filtered out of suggestions entirely. Raise
#                max-weight past these and every deliberately blocked form
#                comes back, derogatory stems and all.
#   graded       Empty here. A graded tag sits deliberately BELOW max-weight:
#                still offerable, but at a weight no real correction can lose
#                to, so it surfaces only when nothing else does. lang-sme
#                grades +Cmp/Hyph to +5000 that way; whether smj should
#                follow is a question for the linguists.
#
# The two lists are declared below rather than inferred from the file,
# because the tiers are indistinguishable by weight alone -- an inferred
# "lowest large weight" rule would read a graded tier as the barrier and
# demand max-weight be dropped to meet it. Any barrier-scale tag in neither
# list fails the test, so adding one forces the choice to be made explicitly
# rather than defaulting to whichever tier the arithmetic happens to pick.
#
# Nothing else in the test suite notices when the barrier moves. typos.tsv
# scores recall only, so removing it reads as a small accuracy gain.
#
# Part 1 checks the invariant against the source files, and so fails even in
# a tree with no speller built. Part 2 proves it end to end on probes that
# are known to leak once the barrier is gone.

# colours
if test -f "$GIELLA_CORE/scripts/termcolors.bash" ; then
    . "$GIELLA_CORE/scripts/termcolors.bash"
fi

TESTER=@DIVVUNSPELL@
PYTHON=@PYTHON@
CONFIG="@srcdir@/../config.json"
REWEIGHT="@srcdir@/../weights/tags.reweight"
ZHFST="@builddir@/../@GTLANG2@.zhfst"
PROBES="@srcdir@/nosugg-probes.tsv"

if test ! -f "$CONFIG" ; then
    printf "%sSKIP%s: %s not found\n" "$light_blue" "$reset" "$CONFIG"
    exit 77
fi
if test ! -f "$REWEIGHT" ; then
    printf "%sSKIP%s: %s not found\n" "$light_blue" "$reset" "$REWEIGHT"
    exit 77
fi

########## Part 1: the config invariant ##########

SENTINEL=$("$PYTHON" - "$REWEIGHT" "$CONFIG" <<'PYEOF'
import json, re, sys

reweight, config = sys.argv[1], sys.argv[2]

# Tags whose forms must never reach a user. Each must price at or above
# max-weight.
HARD_BLOCK = ("+Use/SpellNoSugg", "+Use/Derrog", "+Cmp/Hyph", "+Cmp/SplitR")

# Tags deliberately priced below max-weight: offerable, but only once
# nothing cheaper exists.
GRADED = ()

# Ordinary tag weights are one or two digits. Anything at or above this is a
# barrier of some kind and must be classified as one of the two above.
BARRIER_CUTOFF = 1000

weights = {}
for line in open(reweight, encoding="utf-8"):
    line = line.split("!")[0].strip()
    if not line or line.startswith("#"):
        continue
    parts = re.split(r"\s+", line)
    if len(parts) < 2:
        continue
    try:
        weight = int(parts[-1].lstrip("+"))
    except ValueError:
        continue
    if weight >= BARRIER_CUTOFF:
        weights[parts[0]] = weight

errors = []

# A renamed or deleted tag must not silently disarm the guard.
missing = [t for t in HARD_BLOCK if t not in weights]
if missing:
    errors.append(
        "hard-block tags absent from %s: %s.\n"
        "       They were renamed or dropped; the barrier is unenforced."
        % (reweight, ", ".join(missing))
    )

unclassified = sorted(set(weights) - set(HARD_BLOCK) - set(GRADED))
if unclassified:
    errors.append(
        "barrier-scale tags in neither list: %s.\n"
        "       Classify each as hard-block or graded in this test."
        % ", ".join(unclassified)
    )

max_weight = json.load(open(config, encoding="utf-8")).get("max-weight")
if max_weight is None:
    errors.append("%s has no max-weight; the barrier is unenforced" % config)

if max_weight is not None:
    # divvunspell keeps a candidate when weight <= max-weight, and a blocked
    # candidate always carries its lexical weight on top of the tag, so
    # equality is the intended setting rather than an off-by-one.
    breached = sorted(
        t for t in HARD_BLOCK if t in weights and weights[t] < max_weight
    )
    if breached:
        errors.append(
            "max-weight %s is above hard-block tags %s.\n"
            "       Forms carrying them are suggestable at this ceiling."
            % (max_weight, ", ".join("%s=%s" % (t, weights[t]) for t in breached))
        )
    # A graded tag at or above the ceiling is silently a hard block, which
    # means the grading is not doing what it claims.
    inert = sorted(
        t for t in GRADED if t in weights and weights[t] >= max_weight
    )
    if inert:
        errors.append(
            "graded tags %s are at or above max-weight %s.\n"
            "       They block outright rather than ranking last."
            % (", ".join("%s=%s" % (t, weights[t]) for t in inert), max_weight)
        )

if errors:
    print("ERROR " + "\n       ".join(errors))
    sys.exit(1)

# Part 2 flags any suggestion at or above the cheapest hard block.
print(min(weights[t] for t in HARD_BLOCK))
PYEOF
)
rv=$?
if test $rv -ne 0 ; then
    printf "%sFAIL%s: %s\n" "$red" "$reset" "$SENTINEL"
    exit 1
fi

########## Part 2: the speller actually suppresses them ##########

if test x$TESTER = xfalse ; then
    printf "%sSKIP%s: missing divvunspell, config invariant passed\n" \
        "$light_blue" "$reset"
    exit 77
fi
if test ! -f "$ZHFST" ; then
    printf "%sSKIP%s: %s not found, config invariant passed\n" \
        "$light_blue" "$reset" "$ZHFST"
    exit 77
fi
if test ! -f "$PROBES" ; then
    printf "%sSKIP%s: %s not found, config invariant passed\n" \
        "$light_blue" "$reset" "$PROBES"
    exit 77
fi

INPUTS=$(grep -v '^#' "$PROBES" | cut -f1 | grep -v '^$' | tr '\n' ' ')
if test -z "$INPUTS" ; then
    printf "%sSKIP%s: no probes in %s\n" "$light_blue" "$reset" "$PROBES"
    exit 77
fi

SUGGESTIONS=$(mktemp)
trap 'rm -f "$SUGGESTIONS"' EXIT

# One invocation for every probe: the archive is large and loading it per word
# dominates the runtime.
$TESTER suggest -a "$ZHFST" -c "$CONFIG" --json $INPUTS > "$SUGGESTIONS"
rv=$?
if test $rv -ne 0 ; then
    printf "%sFAIL%s: divvunspell suggest exited %s\n" "$red" "$reset" "$rv"
    exit 1
fi

"$PYTHON" - "$PROBES" "$SENTINEL" "$SUGGESTIONS" <<'PYEOF'
import json, sys

probes_path, floor, suggestions_path = sys.argv[1], float(sys.argv[2]), sys.argv[3]

forbidden = {}
for line in open(probes_path, encoding="utf-8"):
    if line.startswith("#") or not line.strip():
        continue
    parts = line.rstrip("\n").split("\t")
    if len(parts) >= 2:
        forbidden.setdefault(parts[0], []).append(parts[1])

data = json.load(open(suggestions_path, encoding="utf-8"))
failures = []
for entry in data.get("suggest", []):
    word = entry.get("word")
    for suggestion in entry.get("suggestions", []):
        value = suggestion.get("value")
        weight = suggestion.get("weight", 0.0)
        if value in forbidden.get(word, []):
            failures.append(
                "%s offered the blocked form %s (weight %s)"
                % (word, value, weight)
            )
        elif weight >= floor:
            # Catches blocked forms that are not named in the probe file.
            failures.append(
                "%s offered %s at weight %s, at or above the sentinel %s"
                % (word, value, weight, floor)
            )

if failures:
    for failure in failures:
        print("  " + failure)
    sys.exit(1)
PYEOF
rv=$?

if test $rv -ne 0 ; then
    printf "%sFAIL%s: never-suggest forms leaked into suggestions\n" \
        "$red" "$reset"
    exit 1
fi

printf "%sPASS%s\n" "$green" "$reset"
exit 0
